{
  // Relaxed markdownlint config compatible with awesome-lint conventions.
  "default": true,
  "MD013": false,   // line length: allow long lines (tables, links)
  "MD033": false,   // allow inline HTML (badges, <details>, <div align>)
  "MD041": false,   // first line need not be a top-level heading (badges block)
  "MD024": { "siblings_only": true }, // allow repeated headings across sections
  // High-volume formatting rules disabled to match the repo's actual style.
  // NOTE: MD051 (broken-link-fragment) is deliberately left ENABLED — it catches real dead anchors.
  "MD060": false,   // table column style / pipe spacing
  "MD022": false,   // headings need not be surrounded by blank lines
  "MD032": false,   // lists need not be surrounded by blank lines
  "MD058": false,   // tables need not be surrounded by blank lines
  "MD031": false,   // fenced code blocks need not be surrounded by blank lines
  "MD012": false,   // allow multiple consecutive blank lines
  "MD001": false,   // heading levels may increment by more than one
  "MD026": false,   // allow trailing punctuation in headings
  "MD045": false    // allow images without alt text
}
